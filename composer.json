{
  "name": "pds/personal-data-sheet",
  "description": "Authenticated Personal Data Sheet CRUD application",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-session": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Pds\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pds\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
