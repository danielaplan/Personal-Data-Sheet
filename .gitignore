# Local credentials and environment overrides
.env
.env.*
!.env.example
!.env.*.example

# Installed dependencies and package-manager caches
/vendor/
/node_modules/
/composer.phar
/.npm/

# Vendor files - local libraries should use CDN or npm, not be committed
jquery-3.7.1.min.js

# Local tooling and editor settings
/.local/
/.impeccable/
/.idea/
/.vscode/

# Generated test results and language caches
.phpunit.cache/
.phpunit.result.cache
__pycache__/
*.py[cod]
/.pytest_cache/
/coverage/
/test-results/
/playwright-report/

# Runtime logs, temporary files, and seed output
*.log
*.tmp
*.bak
*.swp
*.swo
/seed-output.txt

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Design and documentation files (not needed to run)
DESIGN.md
PRODUCT.md
CRUD-SETUP.md
docs/superpowers/plans/pds-search-list-surface-brief.md

# Developer checks and tests (not needed to run)
scripts/check-form.py
